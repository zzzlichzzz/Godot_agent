        "rel": "part_one.gd",
        "const": "PartOne",
        "funcs": [
          "alpha",
          "beta"
        ],
        "content": "@tool\nextends RefCounted\n\n# Модуль part_one: методы вынесены «пилой» split_gd из donor.gd.\n# Реализация живёт ЗДЕСЬ; в доноре на месте метода — тонкая обёртка,\n# поэтому connect()/call() по исходным именам продолжают работать.\n# Тело работает через параметр panel: к членам донора — panel.<член>,\n# к другим методам донора — panel.<метод> (через его обёртку).\n\n# --- константы, скопированные из донора (неизменяемы) ---\nconst DEFAULT = 2\n\n# alpha doc\nstatic func alpha(panel, a: int = DEFAULT) -> int:\n\tvar x = panel.get_tree()\n\tvar y = x\n\treturn a\n\nstatic func beta(panel) -> void:\n\tpanel.visible = true\n\tawait panel.get_tree().process_frame\n",
        "lines": 22
      },
      {
        "rel": "part_two.gd",
        "const": "PartTwo",
        "funcs": [
          "_private"
        ],
        "content": "@tool\nextends RefCounted\n\n# Модуль part_two: методы вынесены «пилой» split_gd из donor.gd.\n# Реализация живёт ЗДЕСЬ; в доноре на месте метода — тонкая обёртка,\n# поэтому connect()/call() по исходным именам продолжают работать.\n# Тело работает через параметр panel: к членам донора — panel.<член>,\n# к другим методам донора — panel.<метод> (через его обёртку).\n\nstatic func _private(panel):\n\treturn panel.get_node(\"Child\")\n",
        "lines": 12
      },
      {
        "rel": "part_three.gd",
        "const": "PartThree",
        "funcs": [
          "gamma"
        ],
        "content": "@tool\nextends RefCounted\n\n# Модуль part_three: методы вынесены «пилой» split_gd из donor.gd.\n# Реализация живёт ЗДЕСЬ; в доноре на месте метода — тонкая обёртка,\n# поэтому connect()/call() по исходным именам продолжают работать.\n# Тело работает через параметр panel: к членам донора — panel.<член>,\n# к другим методам донора — panel.<метод> (через его обёртку).\n\nstatic static func gamma(panel, value = [1, 2]) -> int:\n\treturn value.size()\n",
        "lines": 12
      }
    ],
    "donor_content": "@tool\nextends Control\n\n# --- части (вынесены «пилой» split_gd) ---\nconst PartOne = preload(\"part_one.gd\")\nconst PartTwo = preload(\"part_two.gd\")\nconst PartThree = preload(\"part_three.gd\")\nconst DEFAULT = 2\n@export var state = 0\n\n# split_gd: тело — part_one.gd\nfunc alpha(a: int = DEFAULT) -> int:\n\treturn PartOne.alpha(self, a)\n\n# split_gd: тело — part_one.gd\nfunc beta() -> void:\n\tawait PartOne.beta(self)\n\nfunc _ready():\n\tstate = 1\n\n# split_gd: тело — part_two.gd\nfunc _private():\n\tPartTwo._private(self)\n\n# split_gd: тело — part_three.gd\nstatic func gamma(value = [1, 2]) -> int:\n\treturn PartThree.gamma(self, value)\n",
