{
  "id": "101-apply-module-compile",
  "tool": "split_apply",
  "fixture": "corpus/editing/split_py/plan_explicit",
  "prepare": {
    "tool": "split_plan",
    "args": {
      "path": "res://donor.py",
      "groups": [
        {
          "module": "part",
          "symbols": [
            "fn"
          ]
        }
      ]
    }
  },
  "args": {
    "path": "res://donor.py",
    "plan": "$prepare.result"
  },
  "test_hook": {
    "module_text": "def broken(:\n"
  },
  "native_capture": {
    "exception": "SplitError",
    "message_contains": "part.py: текст модуля не компилируется"
  },
  "expect": {
    "ok": false,
    "kind": "invalid_input",
    "tree_unchanged": true
  },
  "scenario": "split_plan_apply"
}
