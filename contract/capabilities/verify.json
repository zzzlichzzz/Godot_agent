{
  "schema_version": 1,
  "module_id": "verification.check",
  "capability_id": "verification.check",
  "tool_name": "verify",
  "description": "Проверить один файл проекта текстовыми проверками и честно сказать, что проверено.",
  "input_schema": {
    "type": "object",
    "required": [
      "path"
    ],
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "kinds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "enum": [
            "gd",
            "tscn",
            "py",
            "json",
            "cfg",
            "api",
            "headless"
          ]
        }
      }
    }
  },
  "result_schema": {
    "type": "object",
    "required": [
      "path",
      "problems",
      "checked",
      "auto_fixable",
      "kinds",
      "unavailable"
    ],
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "problems": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "checked": {
        "type": "boolean"
      },
      "auto_fixable": {
        "type": "boolean"
      },
      "kinds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "unavailable": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "unchecked_reason": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "effects": [
    "read"
  ],
  "idempotent": true,
  "requires_preview": false,
  "errors": [
    "invalid_input",
    "not_found",
    "denied"
  ],
  "availability": "*",
  "cost": "cheap",
  "limits": {
    "max_file_bytes": 4194304
  }
}
