{
  "schema_version": 1,
  "module_id": "project_text.read",
  "capability_id": "project_text.read",
  "tool_name": "read",
  "description": "Читает файл проекта res:// без записи. UTF-8 с заменой ошибок, BOM снят, переводы строк LF.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 6,
        "description": "Путь файла res://."
      },
      "max_chars": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200000,
        "default": 50000
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Канонический res:// путь, не абсолютный."
      },
      "content": {
        "type": "string"
      },
      "truncated": {
        "type": "boolean"
      },
      "chars": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200000
      }
    },
    "required": [
      "path",
      "content",
      "truncated",
      "chars"
    ],
    "additionalProperties": false
  },
  "effects": [
    "read"
  ],
  "idempotent": true,
  "requires_preview": false,
  "errors": [
    "invalid_input",
    "not_found",
    "denied"
  ],
  "availability": "*",
  "cost": "cheap",
  "limits": {
    "default_chars": 50000,
    "max_chars": 200000
  }
}
