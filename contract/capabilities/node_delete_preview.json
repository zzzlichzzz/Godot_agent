{
  "schema_version": 1,
  "module_id": "scene_model.node_delete",
  "capability_id": "scene_model.node_delete",
  "tool_name": "node_delete_preview",
  "description": "Read-only native prepare_node_deletion plan; no apply/undo/history/WAL. cleanup_code defaults to true: collect warnings, never rewrite scripts. Lossless Base64 before_bytes/after_bytes; only scene_res and files.absolute omitted. Native structured diff context=3, max600 ordered rows. deleted_nodes target-first then scene order; warnings in attached-script/line order, one per noncomment matching line. Removed-node scripts excluded. reference_count counts scene removals, not warnings. .tscn and textual .scn supported.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "node": {
        "type": "string"
      },
      "cleanup_code": {
        "type": "boolean"
      }
    },
    "required": [
      "path",
      "node"
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "delete_node"
        ]
      },
      "scene": {
        "type": "string"
      },
      "target_node": {
        "type": "string"
      },
      "target_node_path": {
        "type": "string"
      },
      "deleted_nodes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "files": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "patch_file"
              ]
            },
            "path": {
              "type": "string"
            },
            "before_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "before_bytes": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            },
            "after_bytes": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            },
            "diff": {
              "type": "object",
              "properties": {
                "lines": {
                  "type": "array",
                  "maxItems": 600,
                  "items": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": [
                        "string",
                        "integer",
                        "null"
                      ]
                    }
                  }
                },
                "added": {
                  "type": "integer",
                  "minimum": 0
                },
                "removed": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                },
                "path": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "patch_file"
                  ]
                }
              },
              "required": [
                "lines",
                "added",
                "removed",
                "truncated",
                "path",
                "action"
              ],
              "additionalProperties": false
            },
            "occurrences": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "action",
            "path",
            "before_hash",
            "before_bytes",
            "after_bytes",
            "diff",
            "occurrences"
          ],
          "additionalProperties": false
        }
      },
      "reference_count": {
        "type": "integer",
        "minimum": 0
      },
      "affected_paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "file",
            "line",
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "action",
      "scene",
      "target_node",
      "target_node_path",
      "deleted_nodes",
      "files",
      "reference_count",
      "affected_paths",
      "warnings"
    ],
    "additionalProperties": false
  },
  "effects": [
    "read"
  ],
  "idempotent": true,
  "requires_preview": false,
  "errors": [
    "invalid_input",
    "not_found",
    "denied"
  ],
  "availability": "*",
  "cost": "cheap",
  "limits": {
    "max_file_bytes": 4194304
  }
}
