  "idempotent": true,
  "requires_preview": false,
  "errors": [
    "invalid_input",
    "not_found",
    "conflict",
    "denied"
  ],
  "availability": "*",
  "cost": "cheap",
  "limits": {
    "max_file_bytes": 5242880
  }
