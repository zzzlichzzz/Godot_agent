{
  "schema_version": 1,
  "module_id": "assistant.write",
  "capability_id": "assistant.write",
  "tool_name": "assistant_plan",
  "description": "Предпросмотр без записи. Передайте operations для правок текстовых файлов или action для существующих нативных действий. Для применения требуется явное подтверждение пользователя через assistant_confirm.",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": true
      },
      "operations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "create_file": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000,
                  "description": "Путь в проекте, например res://scripts/player.gd."
                },
                "content": {
                  "type": "string",
                  "maxLength": 200000
                }
              },
              "required": [
                "path",
                "content"
              ],
              "additionalProperties": false
            },
            "patch_file": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000,
                  "description": "Путь в проекте, например res://scripts/player.gd."
                },
                "search": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000,
                  "description": "Точный уникальный фрагмент."
                },
                "replace": {
                  "type": "string",
                  "maxLength": 200000
                }
              },
              "required": [
                "path",
                "search",
                "replace"
              ],
              "additionalProperties": false
            },
            "move_file": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000,
                  "description": "Путь в проекте, например res://scripts/player.gd."
                },
                "dest": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000,
                  "description": "Путь в проекте, например res://scripts/player.gd."
                }
              },
              "required": [
                "path",
                "dest"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "required": [],
    "additionalProperties": false,
    "minProperties": 1,
    "maxProperties": 1
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "state": {
        "type": "string",
        "enum": [
          "PREPARED",
          "ALREADY_SATISFIED"
        ]
      },
      "plan_id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,100}$"
      },
      "digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "diffs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200000
            },
            "before": {
              "type": [
                "string",
                "null"
              ]
            },
            "after": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "path",
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "steps_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 356
      },
      "confirm_ttl": {
        "type": "integer"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "state",
      "plan_id",
      "digest",
      "diffs",
      "steps_count",
      "confirm_ttl",
      "warnings"
    ],
    "additionalProperties": false
  },
  "effects": [
    "write"
  ],
  "idempotent": false,
  "requires_preview": false,
  "errors": [
    "invalid_input",
    "not_found",
    "denied",
    "stale_plan",
    "conflict",
    "unavailable",
    "internal"
  ],
  "availability": "*",
  "cost": "bounded",
  "limits": {
    "max_files": 100,
    "max_action_chars": 200000
  }
}
