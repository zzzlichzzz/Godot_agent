{
  "schema_version": 1,
  "module_id": "project_text.search",
  "capability_id": "project_text.search",
  "tool_name": "search",
  "description": "Find a literal substring in permitted project text files. Results are grouped by nearby lines. Use include_rel_prefixes and only_exts to narrow the search; set offset=0 to page, then reuse next_offset and the same query/filters.",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Подстрока для поиска. Пустая строка даёт пустой результат."
      },
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 30,
        "description": "Сколько совпадений вернуть максимум."
      },
      "context_lines": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20,
        "default": 2,
        "description": "Сколько строк до и после совпадения включить в сниппет."
      },
      "exclude_rel_prefixes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "Префиксы относительных путей (например 'addons/'), которые пропускаются ДО набора квоты max_results."
      },
      "case_insensitive": {
        "type": "boolean",
        "default": false,
        "description": "Сравнение без учёта регистра."
      },
      "include_rel_prefixes": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "maxLength": 1024
        },
        "description": "Directory prefixes, e.g. scripts/ or res://scripts. Empty means all."
      },
      "only_exts": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "maxLength": 32
        },
        "description": "Restrict the permitted extensions, e.g. ['.gd', '.tscn']."
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "description": "Number of matching groups to skip. Start at 0 for exact pagination."
      },
      "snippet_chars": {
        "type": "integer",
        "minimum": 64,
        "maximum": 16000,
        "description": "Optional character cap per snippet; clipped snippets end in an ellipsis."
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "matches": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "res:// путь файла."
            },
            "line": {
              "type": "integer",
              "description": "Номер первой строки окна (1-based)."
            },
            "snippet": {
              "type": "string",
              "description": "Строки окна с номерами."
            }
          },
          "required": [
            "path",
            "line",
            "snippet"
          ],
          "additionalProperties": false
        }
      },
      "truncated": {
        "type": "boolean",
        "description": "Квота max_results была набрана: список может быть неполным."
      },
      "next_offset": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "description": "With offset: start of next page, or null."
      }
    },
    "required": [
      "matches",
      "truncated"
    ],
    "additionalProperties": false
  },
  "effects": [
    "read"
  ],
  "idempotent": true,
  "requires_preview": false,
  "errors": [
    "invalid_input",
    "not_found",
    "denied"
  ],
  "availability": "*",
  "cost": "cheap",
  "limits": {
    "max_results": 200,
    "context_lines": 20
  }
}
