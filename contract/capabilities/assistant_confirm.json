{
  "schema_version": 1,
  "module_id": "assistant.write",
  "capability_id": "assistant.write",
  "tool_name": "assistant_confirm",
  "description": "Явно подтвердить или отклонить показанный план.",
  "input_schema": {
    "type": "object",
    "properties": {
      "plan_id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,100}$"
      },
      "digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "approved": {
        "type": "boolean"
      }
    },
    "required": [
      "plan_id",
      "digest",
      "approved"
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "state": {
        "type": "string",
        "enum": [
          "REJECTED",
          "COMMITTED",
          "ROLLED_BACK"
        ]
      },
      "plan_id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,100}$"
      },
      "entry_id": {
        "type": "string"
      },
      "result": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "state",
      "plan_id",
      "entry_id",
      "result"
    ],
    "additionalProperties": false
  },
  "effects": [
    "write"
  ],
  "idempotent": false,
  "requires_preview": true,
  "errors": [
    "invalid_input",
    "not_found",
    "denied",
    "stale_plan",
    "conflict",
    "unavailable",
    "internal"
  ],
  "availability": "*",
  "cost": "bounded",
  "limits": {
    "max_files": 100,
    "max_action_chars": 200000
  }
}
