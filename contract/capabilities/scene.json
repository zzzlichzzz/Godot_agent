{
  "schema_version": 1,
  "module_id": "scene_model.tree",
  "capability_id": "scene_model.tree",
  "tool_name": "scene",
  "description": "Текстовая сводка файла .tscn/.scn: узлы, скрипты, инстансы, сигналы и ресурсы. Текст дословно повторяет describe_scene; структура возвращается полностью. truncated означает фактическую обрезку по max_chars (символы, не байты); суффикс обрезки добавляется сверх квоты. Не запускает Godot и не пишет файлы.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Относительный путь или res://scenes/player.tscn."
      },
      "max_chars": {
        "type": "integer",
        "minimum": 0,
        "default": 12000
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "truncated": {
        "type": "boolean"
      },
      "nodes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "parent": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "script": {
              "type": [
                "string",
                "null"
              ]
            },
            "instance": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "type",
            "parent",
            "path",
            "depth",
            "script",
            "instance"
          ],
          "additionalProperties": false
        }
      },
      "connections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "signal": {
              "type": "string"
            },
            "method": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "to",
            "signal",
            "method"
          ],
          "additionalProperties": false
        }
      },
      "resources": {
        "type": "object",
        "properties": {
          "ext": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "uid": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "type",
                "path",
                "uid"
              ],
              "additionalProperties": false
            }
          },
          "sub": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ext",
          "sub"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "text",
      "truncated",
      "nodes",
      "connections",
      "resources"
    ],
    "additionalProperties": false
  },
  "effects": [
    "read"
  ],
  "idempotent": true,
  "requires_preview": false,
  "errors": [
    "invalid_input",
    "not_found",
    "denied"
  ],
  "availability": "*",
  "cost": "cheap",
  "limits": {
    "max_file_bytes": 4194304,
    "max_chars": 12000
  }
}
