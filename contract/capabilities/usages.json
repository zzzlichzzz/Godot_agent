{
  "schema_version": 1,
  "module_id": "code_intel.usages",
  "capability_id": "code_intel.usages",
  "tool_name": "usages",
  "description": "Ищет, где объявлен символ и где он используется. Вход — вид символа (`function`, `signal`, `variable`, `const`, `enum`, `enum_member`, `class_name`) и его имя. Отдаёт места с координатами, типом связи (`declaration`, `call`, `member`, `identifier`, `type`, `string`, `callable`, `signal`, `scene_connection`) и уверенностью: `proven` — связь доказана, `probable` — вероятна (в `note` причина, чего не хватает, чаще всего аннотации типа), `dynamic` — ссылка по строковому литералу. Ничего не меняет: можно уточнить объявление через declaration или declaration_path.",
  "input_schema": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "class_name",
          "function",
          "signal",
          "variable",
          "const",
          "enum",
          "enum_member"
        ],
        "description": "Вид символа — как в объявлении."
      },
      "old_name": {
        "type": "string",
        "description": "Имя символа (идентификатор GDScript)."
      },
      "declaration": {
        "type": "string",
        "description": "Точный locator `res://path.gd:line[:column]`. Без него требуется одно совпадение по виду и имени в видимых скриптах."
      },
      "declaration_path": {
        "type": "string",
        "minLength": 7,
        "maxLength": 1024,
        "description": "Ограничить поиск объявления одним res:// скриптом вместо точного locator."
      },
      "new_name": {
        "type": "string",
        "description": "Необязательное новое имя: эталон принимает его и возвращает эхом, поиск от него не зависит."
      }
    },
    "required": [
      "kind",
      "old_name"
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string"
      },
      "old_name": {
        "type": "string"
      },
      "new_name": {
        "type": "string"
      },
      "declaration": {
        "type": "string",
        "description": "Переданный или найденный точный locator."
      },
      "usages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "res:// путь файла."
            },
            "line": {
              "type": "integer",
              "description": "Строка (1-based)."
            },
            "column": {
              "type": "integer",
              "description": "Колонка (1-based)."
            },
            "link": {
              "type": "string",
              "description": "declaration | call | member | identifier | type | string | callable | signal | scene_connection"
            },
            "confidence": {
              "type": "string",
              "description": "proven | probable | dynamic"
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "description": "Причина для probable/dynamic; null для proven."
            }
          },
          "required": [
            "path",
            "line",
            "column",
            "link",
            "confidence",
            "note"
          ],
          "additionalProperties": false
        }
      },
      "by_link": {
        "type": "object",
        "description": "Счётчик мест по типу связи."
      },
      "proven_count": {
        "type": "integer"
      },
      "probable_count": {
        "type": "integer"
      },
      "dynamic_count": {
        "type": "integer"
      }
    },
    "required": [
      "kind",
      "old_name",
      "new_name",
      "declaration",
      "usages",
      "by_link",
      "proven_count",
      "probable_count",
      "dynamic_count"
    ],
    "additionalProperties": false
  },
  "effects": [
    "read"
  ],
  "idempotent": true,
  "requires_preview": false,
  "errors": [
    "invalid_input",
    "not_found",
    "denied"
  ],
  "availability": "*",
  "cost": "heavy",
  "limits": {}
}
