{
  "schema_version": 1,
  "module_id": "engine_kb.class_api",
  "capability_id": "engine_kb.class_api",
  "tool_name": "api",
  "description": "Методы, свойства и сигналы класса Godot по всей цепочке наследования из кэша API.",
  "input_schema": {
    "type": "object",
    "required": [
      "class_name"
    ],
    "additionalProperties": false,
    "properties": {
      "class_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    }
  },
  "result_schema": {
    "type": "object",
    "required": [
      "class_name",
      "found",
      "cache_version",
      "inherits",
      "methods",
      "properties",
      "signals",
      "unavailable"
    ],
    "additionalProperties": false,
    "properties": {
      "class_name": {
        "type": "string",
        "minLength": 1
      },
      "found": {
        "type": "boolean"
      },
      "cache_version": {
        "type": "string"
      },
      "inherits": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "methods": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "min_args",
            "max_args",
            "signature"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "min_args": {
              "type": "integer"
            },
            "max_args": {
              "type": "integer"
            },
            "signature": {
              "type": "string"
            }
          }
        }
      },
      "properties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "signals": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "unavailable": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "effects": [
    "read"
  ],
  "idempotent": true,
  "requires_preview": false,
  "errors": [
    "invalid_input"
  ],
  "availability": "*",
  "cost": "cheap",
  "limits": {}
}
